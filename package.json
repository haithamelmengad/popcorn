{
  "name": "claude-popcorn",
  "version": "0.5.1",
  "description": "MCP server that generates transcripts and keyframes for long-form video analysis.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haithamelmengad/claude-popcorn.git"
  },
  "homepage": "https://github.com/haithamelmengad/claude-popcorn#readme",
  "bugs": {
    "url": "https://github.com/haithamelmengad/claude-popcorn/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "video",
    "video-analysis",
    "ffmpeg",
    "whisper",
    "transcription",
    "scene-detection"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "popcorn-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node --test test/smoke.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
